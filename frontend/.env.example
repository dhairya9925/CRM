# Apex CRM Frontend Environment Configuration

# Backend Server Address (used by Vite proxy in development)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base API Route / URL for HTTP requests
# Use '/api' for Vite dev proxy, or a full URL like 'http://127.0.0.1:8000/api' for direct cross-origin access
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_NAME="Apex CRM"
VITE_APP_VERSION="1.0.0"

# Frontend Dev Server Port
VITE_PORT=5173
